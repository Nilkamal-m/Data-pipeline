{
  "_comment": "Bronze Layer Ingestion Configuration — UAX Data Lake Pipeline. All mandatory Secrets Manager keys are documented per source block.",
  "pipeline_defaults": {
    "bronze_bucket": "",
    "state_bucket": "",
    "_note_buckets": "Set bronze_bucket / state_bucket here OR pass --BRONZE_BUCKET / --STATE_BUCKET via CLI. If both are empty the job will raise ValueError at startup.",
    "batch_size": 1000,
    "s3_chunk_size": 10000,
    "max_retries": 3,
    "state_prefix": "metadata/bronze",
    "bronze_data_prefix": "bronze/data",
    "output_format": "parquet",
    "parquet_compression": "snappy",
    "flatten_nested_json": true,
    "flatten_separator": "_",
    "error_handling_mode": "CONTINUE_ON_ERROR",
    "_note_error_modes": "Allowed values: CONTINUE_ON_ERROR (skip failed tables) | HALT_ON_ERROR (stop immediately on first failure)",
    "upper_bound": "",
    "_note_upper_bound": "Optional global upper bound timestamp (format: 'YYYY-MM-DD HH:MM:SS', e.g. '2024-03-01 00:00:00' for backfills). Can also be configured per-table under source_systems.<source>.tables.<table>.upper_bound or passed via CLI --UPPER_BOUND. When empty, extraction runs open-ended up to current run time.",
    "default_initial_load_date": "",
    "_note_default_initial_load_date": "Optional global fallback (format: 'YYYY-MM-DD HH:MM:SS'). If empty, each table MUST have an entry under tables.<table>.initial_load_date or pass --INITIAL_LOAD_DATE via CLI.",
    "glue_catalog": {
      "enabled": true,
      "database_name": "uax_datalake_db_{env}",
      "table_prefix": "raw_tbl_",
      "crawler_name": "uax-datalake-bronze-crawler-{env}",
      "trigger_crawler": true,
      "sync_watermark_table": true,
      "watermark_table_name": "raw_tbl_watermarks"
    },
    "_note_env": "Dynamic environment templating: Any string containing '{env}' or '{ENV}' (e.g. database_name, crawler_name, bronze_bucket) is dynamically resolved at runtime from the --ENV / --ENVIRONMENT Glue parameter (defaults to 'dev')."
  },
  "source_systems": {
    "servicenow": {
      "_secrets_required": ["auth_type", "api_base_url", "username", "password", "batch_size"],
      "_note": "auth_type must be 'basic' or 'oauth'. For oauth also add: token_url, client_id, client_secret.",
      "base_url": "https://your-instance.service-now.com",
      "api_endpoint_template": "/api/now/table/{table_name}",
      "default_delta_filter": "sys_updated_on>={last_load_date}",
      "response_records_key": "result",
      "batch_size": 1000,
      "tables": {
        "incident": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "query_override": "active=true^sys_updated_on>={last_load_date}"
        },
        "change_request": {
          "initial_load_date": "2024-03-01 00:00:00",
          "upper_bound": ""
        },
        "problem": {
          "initial_load_date": "2024-06-01 00:00:00",
          "upper_bound": ""
        },
        "sys_user": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "u_custom_incident": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "query_override": "u_active=true^u_category=hardware^sys_updated_on>={last_load_date}"
        },
        "u_special_report": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "custom_endpoint": "/api/now/v1/custom_reports"
        }
      }
    },
    "genesys": {
      "_secrets_required": ["auth_type", "token_url", "client_id", "client_secret", "grant_type", "api_base_url", "batch_size"],
      "_note": "auth_type must be 'oauth'. grant_type must be 'client_credentials'.",
      "base_url": "https://api.mypurecloud.com",
      "api_endpoint_template": "/api/v2/{table_name}",
      "default_delta_filter": "{last_load_date}",
      "response_records_key": "entities",
      "batch_size": 100,
      "tables": {
        "conversations": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "users": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "queues": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        }
      }
    },
    "moveworks": {
      "_secrets_required": ["auth_type", "token_url", "client_id", "client_secret", "grant_type", "api_base_url", "batch_size"],
      "_note": "auth_type must be 'oauth2'. grant_type must be 'client_credentials'. batch_size max is 500.",
      "base_url": "https://api.moveworks.ai",
      "assistant_name": "acmecorp-conversations-rest-api",
      "api_endpoint_template": "/export/v1beta2/records/{table_name}",
      "default_delta_filter": "last_updated_time ge '{last_load_date}' and last_updated_time le '{upper_bound}'",
      "response_records_key": "value",
      "batch_size": 500,
      "orderby": "last_updated_time desc",
      "parallel_processing": {
        "enabled": true,
        "max_workers": 5,
        "shard_window_days": 15
      },
      "tables": {
        "conversations": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": ""
        },
        "interactions": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": ""
        },
        "plugin_calls": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": "",
          "custom_endpoint": "/export/v1beta2/records/plugin-calls"
        },
        "plugin_cells": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": "",
          "custom_endpoint": "/export/v1beta2/records/plugin-cells"
        },
        "plugin_resources": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": "",
          "custom_endpoint": "/export/v1beta2/records/plugin-resources"
        },
        "users": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": ""
        },
        "tickets": {
          "initial_load_date": "1900-01-01 00:00:00",
          "upper_bound": "",
          "custom_endpoint": "/export/v1beta2/records/conversations"
        }
      }
    },
    "postgresql": {
      "_secrets_required": ["db_type", "host", "dbname", "username", "password", "port"],
      "_note_port": "'port' MUST be in Secrets Manager (not here). The value here (5432) is documentation only — the connector reads it exclusively from Secrets Manager.",
      "connection_type": "database",
      "db_type": "postgresql",
      "port_reference": 5432,
      "default_delta_filter": "updated_at >= '{last_load_date}'",
      "query_template": "SELECT * FROM {table_name} WHERE {query_filter} ORDER BY updated_at ASC",
      "fetch_size": 10000,
      "tables": {
        "orders": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "query_override": "status = 'COMPLETED' AND updated_at >= '{last_load_date}'"
        },
        "order_items": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "customers": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        }
      }
    },
    "mysql": {
      "_secrets_required": ["db_type", "host", "dbname", "username", "password", "port"],
      "_note_port": "'port' MUST be in Secrets Manager. Standard MySQL/MariaDB port is 3306.",
      "connection_type": "database",
      "db_type": "mysql",
      "port_reference": 3306,
      "default_delta_filter": "updated_at >= '{last_load_date}'",
      "query_template": "SELECT * FROM {table_name} WHERE {query_filter} ORDER BY updated_at ASC",
      "fetch_size": 10000,
      "tables": {
        "transactions": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "users": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        },
        "accounts": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": ""
        }
      }
    },
    "vendor_a_s3": {
      "_note": "Vendor A CSV file feed. 'type' must match a key in connectors CONNECTOR_MAP (use 's3_file').",
      "type": "s3_file",
      "source_bucket": "vendor-a-incoming-bucket",
      "file_prefix": "raw_feed/",
      "file_format": "csv",
      "delimiter": ",",
      "has_header": true,
      "encoding": "utf-8",
      "multiLine": true,
      "escape": "\\",
      "fetch_mode": "all",
      "_note_fetch_mode": "'all' = all files modified after watermark (incremental). 'latest' = only the most recently modified file (snapshot/full-refresh).",
      "tables": {
        "employee_feed": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "file_path": "raw_feed/employee_feed/",
          "fetch_mode": "latest"
        },
        "orders": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "file_path": "raw_feed/orders/",
          "fetch_mode": "all"
        }
      }
    },
    "vendor_b_s3": {
      "_note": "Vendor B JSON file feed. 'type' must match a key in connectors CONNECTOR_MAP (use 's3_file').",
      "type": "s3_file",
      "source_bucket": "vendor-b-partner-bucket",
      "file_prefix": "json_feeds/",
      "file_format": "json",
      "fetch_mode": "all",
      "encoding": "utf-8",
      "tables": {
        "user_activity": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "file_path": "json_feeds/user_activity/",
          "fetch_mode": "all"
        },
        "audit_logs": {
          "initial_load_date": "2024-01-01 00:00:00",
          "upper_bound": "",
          "file_path": "json_feeds/audit_logs/",
          "fetch_mode": "latest"
        }
      }
    }
  }
}
