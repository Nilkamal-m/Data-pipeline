{
  "_comment": "Silver Layer Iceberg Transformation Configuration \u2014 UAX Data Lake Pipeline. Modeled uniformly with Bronze Layer configuration.",
  "pipeline_defaults": {
    "silver_bucket": "",
    "state_bucket": "",
    "_note_buckets": "Set silver_bucket / state_bucket here OR pass --DATA_LAKE_BUCKET / --STATE_BUCKET via CLI. If both are empty the job uses environment default.",
    "target_format": "iceberg",
    "table_prefix": "tbl_",
    "merge_strategy": "upsert",
    "scd_type": "scd1",
    "bronze_data_prefix": "bronze/data",
    "silver_data_prefix": "silver/data",
    "state_prefix": "metadata/silver",
    "bronze_technical_columns": [
      "_ingested_at",
      "_source_system",
      "_table_name",
      "_execution_id"
    ],
    "_note_bronze_technical_columns": "System technical and audit columns excluded when reading Bronze payload into Silver Iceberg tables.",
    "technical_columns": {
      "is_deleted_column": "_is_deleted",
      "inserted_at_column": "_inserted_at",
      "updated_at_column": "_updated_at",
      "valid_from_column": "_valid_from",
      "valid_to_column": "_valid_to",
      "is_current_column": "_is_current",
      "high_date_value": "9999-01-01 00:00:00"
    },
    "scd_type2_config": {
      "valid_from_column": "_valid_from",
      "valid_to_column": "_valid_to",
      "is_current_column": "_is_current",
      "high_date_value": "9999-01-01 00:00:00"
    },
    "deduplication": {
      "enabled": true,
      "strategy": "latest_by_order_column",
      "default_nkey": "sys_id",
      "default_order_column": "sys_updated_on"
    },
    "watermark": {
      "enabled": true,
      "metadata_prefix": "metadata/silver",
      "watermark_column": "_ingested_at",
      "sync_watermark_table": true,
      "watermark_table_name": "tbl_watermarks",
      "full_refresh": false
    },
    "glue_catalog": {
      "enabled": true,
      "database_name": "uax_datalake_db_{env}",
      "crawler_name": "uax-datalake-silver-crawler-{env}",
      "trigger_crawler": false,
      "_note_crawler": "Disabled by default for Silver Iceberg tables. Spark SQL natively commits Iceberg metadata and schema evolution directly to the Glue Data Catalog. Standard crawlers crawl /data and /metadata as separate junk tables.",
      "sync_watermark_table": true,
      "watermark_table_name": "tbl_watermarks"
    },
    "_note_env": "Dynamic environment templating: '{env}' or '{ENV}' dynamically resolved at runtime from --ENV / --ENVIRONMENT Glue parameter (defaults to 'dev').",
    "exclude_columns": [],
    "external_columns": []
  },
